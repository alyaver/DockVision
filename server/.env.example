DB_NAME=postgres

# Server-only mail settings for forgot-password. 
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=approved_sending_account@example.com
# EMAIL_PASS=replace_with_provider_app_password
